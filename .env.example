# PayPal Sandbox — developer.paypal.com → Apps & Credentials → Sandbox app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Optional: enable HMAC safeguard on the webhook receiver
# PAYPAL_WEBHOOK_ID=

# AI agent — aistudio.google.com → API keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: custom data directory (defaults to ./data)
# DATA_DIR=
